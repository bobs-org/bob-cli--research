flowchart TD
  THEME["`**Year Theme**<br/>one phrase`"]
  YOUT["`**Year Outcomes**<br/>≤3 results`"]
  QOUT["`**Quarter Outcomes**<br/>≤3 results`"]
  INTENT["`**This week's Intentions**<br/>≤3 bets`"]
  REVIEW["`**Agent Review**<br/>scores each line`"]
