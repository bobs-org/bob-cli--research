title: "When is the section HUD visible?"
accTitle: "Section skip HUD lifecycle"
accDescr: "A successful jump shows the HUD at 0 ms, repeats keep the same card, idle starts a 1200 ms fade, and the timer returns to hidden."
config:
  layout: dagre
  flowchart:
    rankSpacing: 18
