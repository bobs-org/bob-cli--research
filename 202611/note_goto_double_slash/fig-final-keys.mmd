  TASKS -->|"second backslash<br/>right after the alias"| LIT
  NOTES -.->|"Backspace,<br/>empty filter (new)"| TASKS
  TASKS -->|"Backspace,<br/>empty filter"| BLANK
  TASKS -->|"Return on a task row"| OPEN
  NOTES -.->|"Return on a<br/>note row (new)"| OPEN
